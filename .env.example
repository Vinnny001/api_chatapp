PORT=5050

# MongoDB Atlas (database "chat")
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chat?retryWrites=true&w=majority

# Must be identical in the realtime service
JWT_SECRET=change-me
JWT_EXPIRES_IN=90d

# Country code assumed for local numbers like 0712... (254 = Kenya)
DEFAULT_COUNTRY_CODE=254
INTERNAL_SECRET=change-me-too

# Private address of the realtime service (never expose /internal/events publicly)
REALTIME_INTERNAL_URL=http://localhost:5051

# Comma-separated, or * during development. Capacitor: capacitor://localhost (iOS), https://localhost (Android)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# File storage. When set, uploads go to Cloudinary (permanent); otherwise to local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chatapp

# Only for "npm run migrate:mysql" (import from the old app)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=chat
# Where the old app's messages are, if different from MONGO_URI
LEGACY_MONGO_URI=

# Push notifications (Firebase console -> Project settings -> Service accounts ->
# Generate new private key). Paste the whole JSON on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT=

# 1:1 calls: a TURN relay so calls connect on mobile data and strict Wi-Fi (set ONE option).
# The relay only forwards the call's encrypted packets; it can't hear or see the call.
# Cloudflare (free tier): dash.cloudflare.com → Realtime → TURN Server → Create
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Metered.ca:
# METERED_TURN_DOMAIN=yourapp.metered.live
# METERED_TURN_API_KEY=
# Your own coturn (static-auth-secret):
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=
