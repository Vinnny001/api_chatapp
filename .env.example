PORT=5050

# MongoDB Atlas (database "chat")
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chat?retryWrites=true&w=majority

# Must be identical in the realtime service
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
INTERNAL_SECRET=change-me-too

# Private address of the realtime service (never expose /internal/events publicly)
REALTIME_INTERNAL_URL=http://localhost:5051

# Comma-separated, or * during development. Capacitor: capacitor://localhost (iOS), https://localhost (Android)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# File storage. When set, uploads go to Cloudinary (permanent); otherwise to local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chatapp

# Only for "npm run migrate:mysql" (import from the old app)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=chat
# Where the old app's messages are, if different from MONGO_URI
LEGACY_MONGO_URI=
